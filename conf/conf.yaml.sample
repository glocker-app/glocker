# ============================================================================
# glocker configuration — SAMPLE
# ============================================================================
# Easiest: run `make init` — it writes conf/conf.yaml from this file, filling in
# your login and desktop session. Then review it and run `make full-install`. (Or
# copy this to conf/conf.yaml and edit it by hand.)
#
# Every value here is a placeholder or a safe default — replace the example login,
# emails and keywords with your own. The large blocklists are NOT stored in this
# file; `update_domains.py` generates them into conf.d/, pulled in via `!include`
# (see domains.list).
#
# The installed file lives at /etc/glocker/config.yaml and is read by the glocker
# agent. (The glockpeek dashboard reads its own file — see the note just below.)
# ============================================================================

# The glockpeek dashboard is a separate process with its OWN config file,
# /etc/glocker/glockpeek.yaml (see conf/glockpeek.yaml.sample). Nothing about the
# dashboard — mode, listen address, database, mail, captcha — lives here anymore.
# This file is the agent's; that file is the server's. On a personal desktop you
# may not need one at all (glockpeek defaults to local mode + sqlite).

# ── General ───────────────────────────────────────────────────────────────────
# Log verbosity: debug | info | warn | error
log_level: "info"

# Your login account — used by sudoers (whose sudo to restrict) and the usage
# monitor (whose desktop session to track). Required when sudoers is enabled.
user: "yourusername"

# ── Blocking: domains ─────────────────────────────────────────────────────────
# Everything about domain blocking: the switch, the hosts file, the browsers to
# close on a block, the nudge when you hit a blocked site, temporary-unblock
# rules, and the block list itself.
domains:
  enabled: true                 # route blocked domains to 127.0.0.1 in /etc/hosts (made immutable)
  hosts_path: "/etc/hosts"      # leave as-is unless you know why not

  # Browsers killed on every `glocker -block`, so their internal DNS cache is
  # dropped and the new block takes effect at once. Case-insensitive substring
  # match on the process name; ignores time windows; not counted as a violation.
  kill_on_block:
    - firefox
    - chromium
    - chrome
    - brave

  # Optional nudge run when you load a blocked domain. Empty = none (the default).
  # It runs as ROOT from the daemon — no desktop session, and split on whitespace
  # with no shell — so a bare `notify-send`/`paplay` can't reach your desktop. To
  # reach it, re-enter your session inline (no script needed). Examples — swap in
  # your login + uid (`id -u`), failures are non-fatal:
  #   sound:        sudo -u yourusername env XDG_RUNTIME_DIR=/run/user/1000 paplay /usr/share/sounds/freedesktop/stereo/complete.oga
  #   notification: sudo -u yourusername env XDG_RUNTIME_DIR=/run/user/1000 notify-send glocker Blocked
  # (dynamic detail like the blocked host needs a wrapper script — env vars aren't
  # expanded without a shell.)
  blocked_access_command: ""

  # Temporary unblocking: `glocker -unblock "domain:reason"`.
  unblocking:
    reasons: ["work", "research", "emergency"]  # a valid reason is required on -unblock
    log_file: "/var/log/glocker/unblocks.log"
    temp_unblock_time: 20                        # minutes a domain stays unblocked
    max_per_day: 0                               # cap on unblocks per calendar day (0 = unlimited)

  # The block list. Generated blocklists live in conf.d/ (kept out of this file
  # for size) — populate them with `make full-install` or
  # `scripts/update_domains.py all`, then they're pulled in via !include. Comment a line
  # out to disable that source. These files must exist before install.
  list:
    # Your own blocked sites live in conf.d/personal-domains.yaml — `glocker -init`
    # seeds it with a starter set (social media, YouTube, Hacker News). It's yours:
    # update_domains.py never touches it, and it's gitignored. Edit it any time.
    - !include conf.d/personal-domains.yaml

    # Curated blocklists (adult content, ads, malware, proxy-bypass), generated
    # into conf.d/ by update_domains.py. Comment a line to drop that source.
    - !include conf.d/domains-bon-appetit.yaml
    - !include conf.d/domains-stevenblack.yaml
    - !include conf.d/domains-hagezi.yaml
    - !include conf.d/domains-shadowwhisperer.yaml

# ── Blocking: programs ────────────────────────────────────────────────────────
# Programs killed on sight during their windows (matched on process name). Use
# kill_windows (killed DURING the window) or allow_windows (killed OUTSIDE it);
# no windows means killed 24/7. Mark a program `extendible: true` to allow a
# one-hour `glocker -extend "<name>:reason"`, capped to once per rolling 24h.
programs:
  enabled: true
  check_interval_seconds: 5
  list:
    # No windows → killed 24/7. A game platform is a common always-off pick.
    - name: "steam"

    # Killed during work hours, but grant a one-hour pass on demand with
    # `glocker -extend "hexchat:quick question"` (capped to once per 24h).
    - name: "hexchat"
      extendible: true
      kill_windows:
        - start: "09:00"
          end: "17:00"
          days: ["Mon", "Tue", "Wed", "Thu", "Fri"]

# ── Blocking: web content (browser extension) ─────────────────────────────────
content:
  # Log content-violation reports POSTed by the browser extension.
  monitoring:
    enabled: true
    log_file: "/var/log/glocker/reports.log"
  # Keywords the extension watches for. url_keywords match the address,
  # content_keywords match page text, and whitelist pages are never scanned or
  # reported. Add your own terms; the whitelist below are common trusted sites.
  keywords:
    url_keywords: []        # e.g. ["casino", "betting"] — matched against the address
    content_keywords: []    # e.g. ["buy now"] — matched against visible page text
    whitelist:
      - "mail.google.com"
      - "calendar.google.com"
      - "github.com"
      - "stackoverflow.com"
      - "en.wikipedia.org"
      # add any sites that should never be scanned or blocked

# ── Blocking: privileges (sudo) ───────────────────────────────────────────────
# Sudoers control — the REAL enforcement. During allow_windows sudo is permitted;
# outside them the blocked line applies. Keep the blocked line limited to sudo you
# genuinely need; do NOT leave yourself able to edit /etc/hosts, /etc/sudoers, or
# remove glocker.
sudoers:
  enabled: true
  allowed_sudoers_line: "yourusername ALL=(ALL) NOPASSWD:ALL"
  blocked_sudoers_line: "yourusername ALL=(ALL) NOPASSWD: /usr/sbin/pm-suspend, /usr/bin/journalctl"
  # The default allows full sudo all day except 09:00–10:00 (a small demonstration
  # no-sudo window). Edit these windows to set your own blocked periods.
  allow_windows:
    - start: "00:00"
      end: "09:00"
      days: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    - start: "10:00"
      end: "23:59"
      days: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]

# ── Uninstall ─────────────────────────────────────────────────────────────────
# Mindful uninstall gate. When enabled, `glocker -uninstall` must first pass a
# metronome-paced typing challenge: a random sentence is revealed one character
# per second and you type each as it appears; a wrong key, falling behind, or the
# terminal losing focus resets it. This breaks the reflex to bail out. Runs
# client-side in your terminal; if enabled with no tty, the uninstall is refused.
mindful_uninstall:
  enabled: true
  # The timings (reveal cadence, deadlines, challenge length, repeat escalation)
  # have built-in defaults — you only need `enabled`. Advanced: override any of
  # interval_ms / deadline_ms / grace_ms / lines / recency_hours / recent_lines,
  # or set `sentences:` to a custom pool.

# Install/uninstall accountability. `glocker -uninstall` must cite one of these
# reasons. All reasons are gated equally by the mindful gate above — upgrades no
# longer uninstall (glocker -install swaps in place), so there is no bypass.
lifecycle:
  log_file: "/var/log/glocker/lifecycle.log"
  reasons: ["maintenance", "work", "entertainment"]

# ── Accountability & telemetry ────────────────────────────────────────────────
# Violation tracking: after max_violations blocked-access attempts within the
# window, run command (typically a screen lock). glocklock locks for a fixed
# duration then auto-unlocks. The command runs as root and is split on
# whitespace (no shell), so run glocklock as yourself with `sudo -u <you>`.
# glocklock finds your session on its own (a live Wayland socket in
# /run/user/<uid> wins, else the local X display), so don't hardcode
# DISPLAY=:0 — on Wayland that yields an X11 overlay that native surfaces
# (waybar etc.) stay clickable through.
violation_tracking:
  enabled: true
  max_violations: 5
  time_window_minutes: 60
  command: "sudo -u yourusername /usr/local/bin/glocklock"
  lock_duration: 5m
  # Lock-screen background (PNG/JPG). glocker ships one (logo + quote) installed
  # to the path below; point it anywhere, or "" for a plain colour.
  background: "/usr/local/share/glocker/lock-background.png"

# Usage monitor: samples the focused window + idle time to a JSONL log that the
# syncer ships to glockpeek. It runs as root, so it finds your session through
# the top-level `user`: Hyprland and other Wayland sessions are found under
# /run/user/<uid> with no extra settings (GNOME also needs extensions/gnome).
# `display`/`xauthority` only matter on X11 (echo $DISPLAY / $XAUTHORITY). If
# no session is up yet (e.g. at boot), it retries every interval.
usage_monitor:
  enabled: true
  log_file: "/var/log/glocker/usage.jsonl"
  interval_seconds: 60
  display: ":0"
  xauthority: "/run/user/1000/gdm/Xauthority"   # adjust the UID/path for your login manager

# Heartbeat watchdog (glockdoc): a systemd timer (glockdoc.timer; root cron if
# the timer can't be set up) pings the glocker socket every interval_minutes and
# appends a liveness sample to log_file. The schedule + binary intentionally
# SURVIVE uninstall so the run of "alive:false" samples records how long glocker
# stayed removed. `glocker -uninstall ... -purge` removes them too.
heartbeat:
  enabled: true
  interval_minutes: 30
  log_file: "/var/log/glocker/heartbeat.jsonl"
  timeout_seconds: 3

# How the agent ships its local /var records to a glockpeek instance. Local-first:
# it never blocks enforcement — it backfills at startup, then pushes new records
# on a timer, retrying if glockpeek is down.
sync:
  enabled: false                          # turn on to sync to a glockpeek instance
  glockpeek_url: "http://127.0.0.1:4317"  # local glockpeek; point at a remote host to sync off-box
  token: ""                               # ingest bearer token (only for a hosted glockpeek)
  interval_seconds: 300                   # incremental sync cadence
  encrypt: false                          # REQUIRED when enabled is true — choose explicitly:
                                          #   true  = encrypt sensitive fields before upload so a hosted
                                          #           glockpeek only ever stores ciphertext (needs the master
                                          #           key; install it with `glocker -connect`).
                                          #   false = plaintext; only sensible for a local/loopback glockpeek.
  # encrypt_key_file: "/etc/glocker/e2e.key"   # optional; master key path (base64 of 32 bytes). Read only
                                          #   when encrypt is true. Defaults to /etc/glocker/e2e.key if unset.

# ── Accountability notifications (sent by glockpeek, not the agent) ────────────
# glockpeek emails an accountability buddy. Authored here but the SERVER sends it:
# this stanza is synced to glockpeek in cleartext (it needs the addresses/cadence
# to send). Content is counts + liveness only — glockpeek can't read your encrypted
# records, so it reports "how much / went dark", never "what". Requires glockpeek's
# mail to be configured (see conf/glockpeek.yaml.sample).
accountability:
  enabled: false
  buddy_emails: []              # who gets the digest + alerts, e.g. ["friend@example.com"]
  digest_every_hours: 24        # rolling summary cadence: 3, 6, 12, or 24. 0 = no periodic digest
  digest_when_quiet: false      # true = also send an "all clear" when nothing happened
  alerts:
    went_dark: true             # emailed immediately: agent uninstalled / heartbeat gap during use (the dead-man's switch)
    high_violations: 0          # flag the digest when a window reaches N violations (0 = off)

# ── Panic mode ────────────────────────────────────────────────────────────────
# `glocker -panic`: emergency offline enforcement for `duration` minutes — suspends the machine and
# re-suspends on any early wake until the duration elapses. `systemctl suspend`
# works on any systemd system; older setups can use "pm-suspend". Disable to
# refuse -panic. (`glocker -init` picks whichever your system has.)
panic:
  enabled: true
  command: "systemctl suspend"
  duration: 30              # minutes to stay suspended

# ============================================================================
# Blocklist generation
# ============================================================================
# The !include lines under domains.list pull in curated blocklists (adult
# content, ads, malware, proxy-bypass). Manage them with scripts/update_domains.py
# (run from the repo root), which writes one file per source into conf.d/ and
# adds or removes the matching !include line in conf/conf.yaml:
#
#   scripts/update_domains.py              # list sources and their status
#   scripts/update_domains.py all          # fetch/update every source into conf.d/
#   scripts/update_domains.py 1            # update just source #1
#   scripts/update_domains.py strip        # delete the generated conf.d/ files
#
# `make full-install` runs `update_domains.py all` for you. There is no runtime
# reload — after editing config or blocklists, reinstall to apply: `make install`.
# ============================================================================
