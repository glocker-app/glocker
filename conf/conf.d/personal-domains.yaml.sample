# Your own blocked domains.
#
# This file is yours to edit: update_domains.py never touches it (it only manages
# the domains-<source>.yaml curated lists), and it's gitignored so it won't be
# committed. It's pulled into conf.yaml via:
#     - !include conf.d/personal-domains.yaml
# `glocker -init` copies this sample to conf.d/personal-domains.yaml for you.
#
# The file is a YAML sequence of domain entries. Replace the empty list below with
# your sites. Examples:
#
#   # always blocked:
#   - {name: "reddit.com"}
#
#   # blocked only during set windows (else reachable):
#   - name: "news.ycombinator.com"
#     block_windows:
#       - {start: "09:00", end: "17:00", days: ["Mon", "Tue", "Wed", "Thu", "Fri"]}
#
#   # always blocked, but allow a timed `glocker -unblock`:
#   - {name: "youtube.com", unblockable: true}
#
#   # log each block hit for this domain:
#   - {name: "x.com", log_blocking: true}
#
# An empty list (below) blocks nothing extra — add entries and reinstall
# (`make full-install`) to apply.
[]
