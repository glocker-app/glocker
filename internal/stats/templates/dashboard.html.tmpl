<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Clean-URL views live at multi-segment paths (e.g. /analytics/tags); anchor
       all relative asset/API URLs to the root so they don't resolve per-path. -->
  <base href="/" />
  <title>glockpeek · exposure analysis</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2307090d'/%3E%3Ccircle cx='16' cy='16' r='9' fill='none' stroke='%231b2230'/%3E%3Cpath d='M16 6v20M6 16h20' stroke='%23ff4d4d' stroke-width='1'/%3E%3Ccircle cx='16' cy='16' r='2.5' fill='%23ff4d4d'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800;900&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <div class="grain" aria-hidden="true"></div>

  <div class="app">
    <nav class="sidebar">
      <div class="brand">
        <span class="reticle" aria-hidden="true"></span>
        <div class="brand-text">
          <h1>glock<span>peek</span></h1>
          <p class="tagline">exposure analysis</p>
        </div>
      </div>

      <ul class="nav" id="nav">
        <li><button data-view="overview" class="active">Overview</button></li>
        <li><button data-view="analytics">Analytics</button></li>
        <li id="nav-insights" hidden><button data-view="insights">Insights</button></li>
        <li id="nav-config" hidden><button data-view="config">Config</button></li>
        <li id="nav-devices" hidden><button data-view="devices">Devices</button></li>
        <li id="nav-users" class="nav-admin" hidden><button data-view="users">Admin</button></li>
      </ul>

      <div class="sidebar-foot">
        <div id="range-readout" class="range-readout" hidden></div>
        <button id="refresh-btn" class="refresh-btn" type="button" title="Refresh data"></button>
        <hr class="foot-sep" />
        <span id="footer-version" class="src">{{ if .Version }}<span class="ver">{{ .Version }}</span>{{ end }}</span>
      </div>
    </nav>

    <div class="content">
      <header class="main-header">
        <h2 class="view-title" id="view-title">Overview</h2>
        <!-- Traditional account menu (hosted only): top-right dropdown. -->
        <div class="account" id="account-menu" hidden>
          <button class="account-btn" id="account-btn" type="button" aria-haspopup="true" aria-expanded="false">
            <span id="account-label">Account</span>
            <span class="account-caret" aria-hidden="true">&#9662;</span>
          </button>
          <div class="account-drop" id="account-drop" hidden>
            <button id="logout-btn" class="account-item" type="button">Sign out</button>
          </div>
        </div>
      </header>

      <main id="dash" hidden>
        <!-- Overview -->
        <section class="view active" data-view="overview">
          <section class="panel score-hero" title="A 0–100 health score over all recorded history (not the selected window): 100 minus weighted penalties for unmanaged time, violations, and deliberate days. Hover each penalty for its weight.">
            <div class="panel-head">
              <h2>Composite health</h2>
              <p class="panel-sub">100 minus penalties for unmanaged time, violations, and deliberate days, over all history (not the window). Higher is better.</p>
            </div>
            <div class="score-split">
              <div class="score-body" id="score"></div>
              <div class="score-explain" id="score-explain"></div>
            </div>
          </section>

          <section class="readout" id="streak" title="Consecutive clean days: no violations and glocker running (a day more than 50% uninstalled breaks the streak too). A standing metric over all recorded history — not affected by the time-window picker."></section>

          <section class="readout" id="readout"></section>

          <section class="panel sync-panel">
            <div class="panel-head">
              <h2>Data sync</h2>
              <p class="panel-sub">When the glocker daemon last pushed records into glockpeek, and what the last batch carried.</p>
            </div>
            <div id="sync-status" class="sync-status"></div>
          </section>
        </section>

        <!-- History (with Patterns widgets appended below) -->
        <section class="view" data-view="analytics">
          <!-- Sub-tabs first (and sticky) so they stay on top and don't move when
               the Range strip below hides for Tags. -->
          <nav class="subtabs" id="analytics-subtabs">
            <button data-subtab="history" class="active">History</button>
            <button data-subtab="usage">Usage</button>
            <button data-subtab="tags">Tags</button>
          </nav>

          <!-- Shared range selector (History/Usage): brush to pick the window. -->
          <section class="panel strip-panel">
            <div class="panel-head">
              <h2>Range</h2>
              <p class="panel-sub">Drag to pick the window.</p>
            </div>
            <div class="spark-wrap"><canvas id="chart-timeline"></canvas></div>
            <div class="tl-legend">
              <span class="tl-key"><span class="tl-sw tl-line"></span> violations/day</span>
              <span class="tl-key"><span class="tl-sw tl-line2"></span> unblocks/day</span>
              <span class="tl-key"><span class="tl-sw tl-band"></span> unmanaged</span>
            </div>
          </section>

          <div class="subview active" data-subtab="history">
          <div class="history">
            <div class="history-main">
              <section class="panel">
                <div class="panel-head">
                  <h2>History calendar</h2>
                  <p class="panel-sub">Each cell is a day: clean, violations, or unmanaged (glocker off). Click a day for details.</p>
                </div>
                <div id="calendar" class="calendar"></div>
              </section>
            </div>

            <aside class="history-side">
              <section class="panel day-inspector">
                <div class="panel-head"><h2>Day detail</h2></div>
                <div id="day-detail" class="day-detail"></div>
              </section>
            </aside>
          </div>

          <!-- Vulnerability map + Unblocks-by-hour share one panel: the heatmap
               is compact, so the by-hour chart fills the space beside it rather
               than the map's cell stretching tall and empty. -->
          <section class="panel">
            <div class="vuln-row">
              <div class="vuln-col vuln-col-heat">
                <div class="panel-head">
                  <h2>Vulnerability map</h2>
                  <p class="panel-sub">Violations by hour &times; weekday.</p>
                </div>
                <div id="heatmap" class="heatmap"></div>
                <div class="heatmap-legend" id="heatmap-legend"></div>
              </div>
              <div class="vuln-col vuln-col-unblock">
                <div class="panel-head">
                  <h2>Unblocks by hour</h2>
                  <p class="panel-sub">When in the day you unblock, by reason.</p>
                </div>
                <div class="hour-chart"><canvas id="chart-unblock-hour"></canvas></div>
              </div>
            </div>
          </section>

          <!-- Bypasses folded into History: exposure over time + deliberate grants -->
          <div class="grid-2">
            <section class="panel">
              <div class="panel-head">
                <h2>Exposure over time</h2>
                <p class="panel-sub">Time glocker wasn&rsquo;t guarding, split by cause &mdash; <strong>removed</strong> (uninstalled) vs <strong>stopped</strong> (installed but not running).</p>
              </div>
              <div class="tall-chart"><canvas id="chart-exposure"></canvas></div>
            </section>
            <section class="panel">
              <div class="panel-head">
                <h2>Unblocks</h2>
                <p class="panel-sub">Deliberate temporary grants &mdash; most recent first.</p>
              </div>
              <div id="unblock-list" class="unmanaged-list"></div>
            </section>
          </div>

          <!-- False positives hidden from the day-detail hit list -->
          <section class="panel">
            <details class="collapse">
              <summary><h2>Ignored violations</h2><span id="ignored-count" class="collapse-count"></span></summary>
              <p class="panel-sub">Hits you marked &ldquo;not a violation&rdquo;. Hidden from every count; restore any to bring it back.</p>
              <div id="ignored-list" class="ign-list"></div>
            </details>
          </section>
          </div><!-- /subview history -->

          <div class="subview" data-subtab="usage">
          <section class="readout" id="usage-readout"></section>

          <!-- Namespace selector: the tag charts below show one namespace
               (prefix) at a time, so each breakdown sums cleanly. -->
          <nav class="ns-pills" id="usage-ns-pills"></nav>

          <!-- Per-day activity -->
          <section class="panel">
            <div class="panel-head">
              <h2>Activity per day</h2>
              <p class="panel-sub">Active time per day, stacked by tag. Labels show each day's total and its share of 24h.</p>
            </div>
            <div id="usage-perday-wrap" class="tall-chart"><canvas id="chart-usage-perday"></canvas></div>
          </section>

          <!-- Tag breakdowns -->
          <div class="grid-2">
            <section class="panel">
              <div class="panel-head">
                <h2>Time by tag</h2>
                <p class="panel-sub">Active time by tag, with untagged shown for coverage. Click a tag to see what fed it.</p>
              </div>
              <div id="usage-tags-wrap" class="tall-chart"><canvas id="chart-usage-tags"></canvas></div>
            </section>
            <section class="panel">
              <div class="panel-head">
                <h2>Tag activity by hour of day</h2>
                <p class="panel-sub">Active hours in each hour-of-day slot (00&ndash;23), stacked by tag.</p>
              </div>
              <div id="usage-taghours-wrap" class="tall-chart"><canvas id="chart-usage-taghours"></canvas></div>
            </section>
          </div>

          <!-- Tag drill-down: which windows fed the selected tag -->
          <section class="panel">
            <details class="collapse" open>
              <summary><h2 id="usage-tag-detail-head">Tag contributors</h2></summary>
              <p class="panel-sub">Click a tag above, then an app to see its windows and common title words.</p>
              <div class="tagc-split">
                <div id="usage-tag-detail" class="tagtree"></div>
                <div class="tagc-pie">
                  <div class="tagc-pie-head" id="tagc-pie-head">Common words</div>
                  <div id="tagc-pie-body"><div class="empty">click an app to see its common title words</div></div>
                </div>
              </div>
            </details>
          </section>

          <!-- Untagged items feed rule creation. Collapsed by default — only
               worth opening when there's meaningful untagged time. -->
          <section class="panel">
            <details class="untag-details">
              <summary class="untag-summary">
                <h2>Untagged windows</h2>
                <span id="untagged-total" class="untag-total"></span>
              </summary>
              <p class="panel-sub">Top windows no rule matched. Click &plus; tag to make a rule for one, or hide to drop it.</p>
              <div id="usage-untagged" class="untag-list"></div>
            </details>
          </section>

          <!-- Rules at the bottom -->
          <section class="panel">
            <details class="collapse" open>
            <summary><h2>Rules</h2></summary>
            <p class="panel-sub">Match on program &amp; title regexes (blank = anything) and attach a tag per namespace. Drag to reorder: first match per namespace wins. Edit tags on the <strong>Tags</strong> sub-tab.</p>
            <div class="rules-editor">
              <div class="rules-head">
                <span></span><span>Program</span><span>Title</span><span>Tags</span><span></span>
              </div>
              <div id="rules-rows"></div>
              <button id="rule-add" class="btn-ghost" type="button">+ Add rule</button>
            </div>

            <!-- Hidden windows: rules that drop a window from usage. A last
                 resort — applied only when no rule above matches. -->
            <div class="hide-editor">
              <h3 class="hide-title">Hidden windows</h3>
              <p class="panel-sub">Entries matching the following rules will be hidden from all analytics.</p>
              <div class="hide-head"><span>Program</span><span>Title</span><span></span></div>
              <div id="hide-rows"></div>
              <button id="hide-add" class="btn-ghost" type="button">+ Add hidden window</button>
            </div>

            <div class="rules-actions">
              <span class="rules-status" id="rules-status"></span>
              <button id="rule-save" class="btn-primary" type="button">Save rules</button>
            </div>
            </details>
          </section>
          </div><!-- /subview usage -->

          <!-- Tags: the registry editor (Phase 4). Grouped by namespace. -->
          <div class="subview" data-subtab="tags">
          <section class="panel">
            <div class="panel-head">
              <h2>Tag registry</h2>
              <p class="panel-sub">Tags are <code>Namespace:name</code>. Shared <strong>Glocker</strong> tags come built-in — flag them as distractions, but their name and colour are fixed. Add your own below.</p>
            </div>
            <div id="tags-registry"></div>
            <div class="tags-add-ns">
              <input id="tags-new-ns" placeholder="new namespace, e.g. Activity" spellcheck="false" autocomplete="off" />
              <button id="tags-add-ns-btn" class="btn-ghost" type="button">+ Add namespace</button>
              <span class="rules-status" id="tags-status"></span>
            </div>
          </section>
          </div><!-- /subview tags -->
        </section><!-- /view analytics -->

        <section class="view" data-view="insights">
          <section class="panel strip-panel">
            <div class="panel-head">
              <h2>Insights</h2>
              <p class="panel-sub"><span id="insights-sub"></span></p>
            </div>
            <div class="spark-wrap"><canvas id="insights-timeline"></canvas></div>
          </section>
          <section class="panel">
            <p id="insights-noconfig" class="insight-noconfig" hidden></p>
            <div class="insights-body">
              <div class="insight-side">
                <div id="insights-controls" class="insights-controls"></div>
                <nav id="insights-nav" class="insight-nav"></nav>
              </div>
              <div id="insights-detail" class="insight-detail"></div>
            </div>
            <p id="insights-empty" class="config-empty" hidden>Nothing to suggest in this window.</p>
            <p id="insights-error" class="login-error" hidden></p>
          </section>
        </section>

        <section class="view" data-view="config">
          <section class="panel">
            <div class="panel-head">
              <h2>Configuration</h2>
              <p class="panel-sub">What each device is enforcing. Synced end-to-end encrypted, decrypted in your browser. <span id="config-sub"></span></p>
            </div>
            <div id="config-list" class="config-list"></div>
            <p id="config-empty" class="config-empty" hidden>No configuration synced yet. It shows up here once a device running a recent glocker syncs its config.</p>
            <p id="config-error" class="login-error" hidden></p>
          </section>
        </section>

        <section class="view" data-view="devices">
          <section class="panel">
            <div class="panel-head">
              <h2>Connected devices</h2>
              <p class="panel-sub">Each device is a glocker agent syncing to glockpeek with its own ingest token. <span id="device-usage"></span></p>
            </div>

            <div id="device-list" class="device-list"></div>

            <div class="device-add">
              <input id="device-name" type="text" maxlength="64" placeholder="Name this device (e.g. laptop)" />
              <button id="add-device" class="btn-primary" type="button">Connect a device</button>
            </div>
            <p id="device-error" class="login-error" hidden></p>
            <p id="device-upsell" class="device-upsell" hidden></p>

            <div id="device-reveal" class="device-reveal" hidden>
              <p class="panel-sub">Add this to <code>/etc/glocker/config.yaml</code> on the new device, then restart glocker. The token is shown <strong>once</strong> — copy it now.</p>
              <pre id="device-config" class="device-config"></pre>
              <div class="device-reveal-actions">
                <button id="device-copy" class="btn-primary" type="button">Copy config</button>
                <button id="device-done" class="btn-ghost" type="button">Done</button>
              </div>
            </div>
          </section>
        </section>

        <section class="view" data-view="users">
          <section class="panel">
            <div class="panel-head">
              <h2>Accounts</h2>
              <p class="panel-sub">Every glockpeek account. As admin you can set a device limit or delete an account and all of its data. <span id="user-count"></span></p>
            </div>
            <div id="user-list" class="user-list"></div>
            <p id="user-error" class="login-error" hidden></p>
          </section>
        </section>
      </main>
    </div>
  </div>

  <div id="login" class="login-screen" hidden>
    <form id="login-form" class="login-card">
      <div class="brand">
        <span class="reticle" aria-hidden="true"></span>
        <div class="brand-text">
          <h1>glock<span>peek</span></h1>
          <p class="tagline">exposure analysis</p>
        </div>
      </div>
      <label>Email
        <input id="login-user" name="email" type="email" autocomplete="email" autocapitalize="none" spellcheck="false" required />
      </label>
      <label>Password
        <input id="login-pass" name="password" type="password" autocomplete="current-password" required />
      </label>
      <button type="submit" class="btn-primary">Sign in</button>
      <p class="login-error" id="login-error" hidden></p>
      <p class="login-alt">No account yet? <a href="#" id="show-register">Create one</a></p>
    </form>

    <form id="register-form" class="login-card" hidden>
      <div class="brand">
        <span class="reticle" aria-hidden="true"></span>
        <div class="brand-text">
          <h1>glock<span>peek</span></h1>
          <p class="tagline">create your account</p>
        </div>
      </div>
      <label>Email
        <input id="reg-user" name="email" type="email" autocomplete="email" autocapitalize="none" spellcheck="false" required />
      </label>
      <label>Password
        <input id="reg-pass" name="password" type="password" autocomplete="new-password" minlength="8" required />
      </label>
      <label>Confirm password
        <input id="reg-pass2" name="password2" type="password" autocomplete="new-password" minlength="8" required />
      </label>
      <button type="submit" class="btn-primary" id="register-submit">Create account</button>
      <p class="login-error" id="register-error" hidden></p>
      <p class="login-note" id="register-note" hidden></p>
      <p class="login-alt">Already have an account? <a href="#" id="show-login">Sign in</a></p>
    </form>
  </div>

  <!-- Boot screen. Everything arrives sealed, so there is a real wait here on a
       long history; the dial reports it rather than hiding it. app.js drives the
       phase label, the --p fill fraction and the counter (see bootProgress). -->
  <div id="loading" class="loading">
    <div class="boot indeterminate" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Preparing your dashboard">
      <div class="boot-dial">
        <svg class="boot-ring" viewBox="0 0 120 120" aria-hidden="true">
          <circle class="boot-track" cx="60" cy="60" r="54" />
          <circle class="boot-arc" cx="60" cy="60" r="54" />
        </svg>
        <div class="boot-pct" id="boot-pct">&mdash;</div>
      </div>
      <div class="boot-phase" id="boot-phase">connecting</div>
      <div class="boot-count" id="boot-count"></div>
    </div>
  </div>
  <div id="error" class="error" hidden></div>

  <script src="chart.umd.min.js"></script>
  <script src="app.js" type="module"></script>
</body>
</html>
