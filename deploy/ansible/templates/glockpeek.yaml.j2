# Managed by Ansible. This is the glockpeek dashboard's own config file; the
# agent's config lives elsewhere and not on this server-only host. Everything is
# under a single top-level `glockpeek:` stanza.
glockpeek:
  mode: "hosted"
  listen: "127.0.0.1:4317"
  secure_cookies: true

  database:
    driver: "postgres"
    dsn: "host=127.0.0.1 port=5432 user={{ pg_user }} password={{ pg_password }} dbname={{ pg_db }} sslmode=disable"

  # Public base URL, used to build verification links in emails.
  app_url: "https://{{ dashboard_domain }}"

  # Account granted admin powers (user management in the dashboard).
  admin_email: "{{ admin_email | default('') }}"

  # Proof-of-work captcha on signup (anti-abuse).
  captcha: {{ (captcha | default(true)) | string | lower }}

  # Outbound email for account verification. SERVER-SIDE ONLY — this key lives
  # here on the glockpeek host and never on an agent.
  mail:
    enabled: {{ (mail_enabled | default(false)) | string | lower }}
    domain: "{{ mail_domain | default('') }}"
    api_key: "{{ mail_api_key | default('') }}"
    from: "{{ mail_from | default('') }}"
    region: "{{ mail_region | default('us') }}"
