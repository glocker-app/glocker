# Generated blocklists (large); keep the directory in the repo via .gitkeep.
conf/conf.d/*.yaml
# `make edit-dev` saves next to the originals.
conf/*.new
conf/conf.d/*.new
sync-findings.md
# Personal planning notes — kept local, not tracked
ROADMAP.md
PLAN.md
LATER.md
.aider*
extensions/firefox/web-ext-artifacts/
extensions/firefox/.amo-upload-uuid
.claude
README.html
/dist/

# Editor swap files
*.swp
*.swo

# Tool caches
__pycache__/
.mypy_cache/
.ropeproject/

# e2ekit default encrypted-record output (prototype artifact)
record.json

# e2ekit prototype secret outputs — a real master key / vault; never commit
master.key
vault.json
*.key

# Local DB dumps (make db-backup) — contain password hashes + the wrapped key vault
deploy/backups/

# Emacs lock files
.#*
# Local habits.md exports
docs/habits.odt
docs/habits.pdf

# Hosted-only curated Glocker starter rules (loaded via `glockpeek -import-rules`)
tags.json

