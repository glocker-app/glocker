{
  "manifest_version": 2,
  "name": "Glocker Content Monitor",
  "version": "2.7",
  "description": "Collects:\n• URLs/domains of pages matching a blocked keyword — sent to your local Glocker service (127.0.0.1)\n• page text — scanned locally for keywords; page content itself is not transmitted",

  "browser_specific_settings": {
    "gecko": {
      "id": "glocker@nibrahim.net.in",
      "data_collection_permissions": {
        "required": ["browsingActivity"],
        "optional": []
      }
    }
  },
  
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  
  "incognito": "spanning",
  
  "background": {
    "scripts": ["build-info.js", "background.js"]
  },
  
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  
  "browser_action": {
    "default_title": "Glocker Status",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png"
  }
}
